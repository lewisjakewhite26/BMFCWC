# Frontend (safe to expose — used in the browser)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only — add to Vercel project settings, NEVER use VITE_ prefix
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# API-Football (server-side only)
API_FOOTBALL_KEY=your_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_LEAGUE=1
API_FOOTBALL_SEASON=2026

# Vercel Cron authentication (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate_a_random_secret_here
